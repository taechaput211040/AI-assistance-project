# Turso (libSQL) connection — ใช้ตอน deploy จริง
# ถ้าไม่ตั้งค่าทั้งสองตัวนี้ ระบบจะใช้ไฟล์ SQLite local ที่ .data/app.db อัตโนมัติ (ดีฟอลต์สำหรับ dev)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Google Maps — เปิด "Places API (New)" + billing แล้วเอา key มาใส่
# ใช้โดย scripts/fetch-restaurants.mjs (เมนู 3) — รัน: npm run fetch:restaurants
GOOGLE_MAPS_API_KEY=your-google-maps-api-key


# (ตัวเลือก) Foursquare Places API — แหล่งที่ 2 ไว้เติมราคา (Service API Key จาก Foursquare)
# ถ้าไม่ใส่ ระบบจะใช้ราคาจาก Google อย่างเดียว (ไม่พัง)
FOURSQUARE_API_KEY=your-foursquare-service-key

# (ตัวเลือก) ป้องกัน route cron ไม่ให้คนอื่นยิงมั่ว — ตั้งแล้ว Vercel Cron จะแนบให้อัตโนมัติ
CRON_SECRET=any-long-random-string
